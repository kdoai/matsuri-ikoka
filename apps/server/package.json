    "@matsuri-ikoka/schema": "workspace:*",
    "firebase-admin": "14.5.0",
    "google-auth-library": "11.3.2",
    "hono": "4.13.16",
    "playwright-core": "1.64.1",
    "undici": "7.30.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
