  "etiquette": {
    "participation": "join_open",
    "howToJoin": "申し込みは要らない。舞庭で掛け声や歌ぐらに合わせて体を動かすことが勧められている。一力花は当日に申し込んで献銭すると自分のための舞を舞ってもらえ、自信があれば自分で舞ってもよい（金額は地区ごとに違う）。花見舞（のし袋に「お見舞」などと書き、一人2千円ほど）を会所に納めると、地区の品やお札、酒、けんちん汁などのお返しがある",
    "rules": [
      "舞手の動きを妨げない",
      "観客（セイト衆）の場所を占領しない",
      "車を運転する人は酒を飲まない",
      "車で行くなら冬用タイヤを付ける"
    ],
    "dress": ["夜通しの祭りで冷え込むので、防寒の支度をする"],
    "bring": ["湯ばやしで湯がかかるので着替え", "花見舞を入れたのし袋（一人2千円ほど）"],
    "risk": {
      "level": "medium",
      "reason": "山あいの集落で夜通し行い、町は冷え込みへの備えと冬用タイヤを勧めている。終盤の湯ばやしでは釜の湯が見物人にもかかる"
    },
