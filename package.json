{
  "name": "matsuri-ikoka",
  "version": "0.0.0",
  "private": true,
  "description": "地元の外にまだ届いていない日本の祭りを、作法まで分かる旅程と旅のしおりにする AI の旅行代理店",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --recursive run dev",
    "build": "pnpm --recursive run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm --recursive run typecheck && tsc -p scripts",
    "test": "vitest run && vitest run --root scripts",
    "test:watch": "vitest",
    "validate:data": "pnpm --filter @matsuri-ikoka/server exec tsx ../../scripts/validate-festivals.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
