{
  "name": "matsuri-ikoka",
  "version": "0.0.0",
  "private": true,
  "description": "地元の外にまだ届いていない日本の祭りを、作法まで分かる旅程と旅のしおりにする AI の旅行代理店",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --recursive run dev",
    "build": "pnpm --recursive run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm --recursive run typecheck && tsc -p scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:data": "tsx scripts/validate-festivals.ts",
    "build:stations": "tsx scripts/build-stations.ts",
    "refresh:targets": "tsx scripts/refresh-targets.ts",
    "refresh:run": "tsx scripts/run-managed-agent.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@biomejs/biome": "2.6.4",
    "@types/node": "^22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
