# 接客サーバー（apps/server）の設定。
# このファイルをリポジトリのルートに .env としてコピーして値を入れる（pnpm dev が読む）。.env は Git の対象外。
# ここには変数名と説明だけを書き、値は書かない。

# サーバーのポート（省略時は 8787）。画面の開発サーバーも、このポートへ中継する
PORT=

# 画面の開発サーバーのポート（省略時は 5173）。ふさがっていたら、ずらさずに止まる
MATSURI_WEB_PORT=

# 接客エージェントの動かし方：mock（記録したサンプルの相談を再生する。キー不要）/ live（Claude Agent SDK）
MATSURI_AGENT_MODE=

# live で使う Claude の API キー。Claude Code にログイン済みの環境では空のままでよい
ANTHROPIC_API_KEY=

# live で使うモデル名（役割ごと。docs/spec/agents.md の「モデルの割り当て」）
# コンシェルジュ
MODEL_CONCIERGE=
# 祭り調査係と周辺係、候補を出す前の開催の確かめ（勧める値：claude-sonnet-5-5）
MODEL_STAFF=
# 旅程係（省略時は MODEL_STAFF）。移動・食事・乗り換えをそろえて組むので、強いモデルを勧める（例：claude-opus-5-5）
MODEL_PLANNER=
# 旅程の評価係（省略時は MODEL_PLANNER、それもなければ MODEL_STAFF）。例：claude-opus-5-5
MODEL_EVALUATOR=
# 確定前の再確認（省略時は MODEL_STAFF）
MODEL_VERIFIER=
# 祭りから探すときの、自由記述の読み取り（省略時は軽いモデルの別名 haiku）
MODEL_WISH_READER=
# しおりのあとのガイド。例：claude-sonnet-5-5。live で空なら、ガイドの入口だけが断り、今の相談は動く
MODEL_GUIDE=

# 祭りのデータを読む場所（省略時は data/festivals。空なら、本番でなければ架空の祭りの data/samples/festivals）
MATSURI_FESTIVALS_DIR=

# 公開している URL の合言葉（画面からはヘッダー x-access-passcode で送る）。空なら確かめない
ACCESS_PASSCODE=

# 1日の相談の回数の上限。空か 0 なら上限なし
DAILY_CHAT_LIMIT=

# mock の再生の速さの倍率（1 で記録どおり、5 で5倍速、0 で待たない）
MATSURI_REPLAY_SPEED=

# live の1回の発言の費用の上限（米ドル、Agent SDK の推定で判定）。空なら上限なし
AGENT_MAX_BUDGET_USD=

# 同じオリジンから配る画面のビルドの場所（本番の既定は apps/web/dist。開発では Vite が配るので空でよい）
MATSURI_WEB_DIST=

# 1日の相談の回数の、利用者ごとの上限（ログインしていなければ IP ごと）。空か 0 なら上限なし
DAILY_CHAT_LIMIT_PER_IP=

# live で同時に返事を作る数の上限（省略時は 4）。超えた発言は 503 で断る
MAX_CONCURRENT_TURNS=

# live で同時に返事を作る数の、利用者ごとの上限（ログインしていなければ IP ごと）。省略時は全体の半分（切り上げ）。超えた発言は 503 で断る
MAX_CONCURRENT_TURNS_PER_CLIENT=

# ガイドの1日の上限（docs/spec/guide.md）。空なら既定の値（回数 60・40、費用 3・2 米ドル）。緊急の案内は上限でも断らない
# 回数：利用者ごと（ログインしていなければ IP ごと）・旅ごと
GUIDE_DAILY_TURNS_PER_USER=
GUIDE_DAILY_TURNS_PER_TRIP=
# 費用（米ドル。Agent SDK の推定で、ツールの中の調べの分も含める）：利用者ごと・旅ごと
GUIDE_DAILY_COST_USD_PER_USER=
GUIDE_DAILY_COST_USD_PER_TRIP=

# 内部の入口の検証（docs/spec/api.md の「内部の入口」）。どれも省略できる。設定がなければ、その入口だけが断る
# 定期実行の OIDC トークンの宛先と、呼んでよいサービスアカウント（両方がそろったときだけ使う）
INTERNAL_OIDC_AUDIENCE=
INTERNAL_OIDC_CALLER_EMAIL=
# Managed Agents の Webhook の署名の鍵（whsec_…）
ANTHROPIC_WEBHOOK_SIGNING_KEY=

# 旅の見回り（docs/spec/operations.md の「旅の見回り」）。live でだけ動く。鍵が空なら、見回りの入口だけが断る
# 見回りのワークスペースの API キー（接客の ANTHROPIC_API_KEY とは別のもの）
PATROL_ANTHROPIC_API_KEY=
# セッションの予算（米ドル。既定 2、上限 10）
PATROL_SESSION_BUDGET_USD=
# 1回の起動で調べる対象の数（既定 20、上限 20）
PATROL_MAX_TARGETS=
# 同じ対象を調べる間隔（時間。既定 6、下限 1）
PATROL_CHECK_INTERVAL_HOURS=

# 利用者との間に置いたプロキシ（ロードバランサーなど）の数。X-Forwarded-For の右から数えて利用者の IP を決める。0 なら接続の相手を使う
TRUSTED_PROXY_HOPS=

# 宿の空きを調べる楽天トラベルの空室検索 API（docs/adr/0006-lodging-search.md）
# アプリ ID とアクセスキーの両方がそろうと使う。空なら、開発では架空の宿、本番では「調べられない」と返す
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
# アプリの登録で入れた「許可されたWebサイト」（https の URL）。呼び出しの Referer と Origin に付ける
RAKUTEN_ALLOWED_SITE=

# ログインと保存（docs/spec/account.md）
# 旅程・共有・相談の途中の状態の保存先：memory（既定。再起動で消える）/ firestore
MATSURI_STORAGE=
# Firebase（Google Cloud）のプロジェクト ID。手元のエミュレーターでは demo- で始まる名前にする
FIREBASE_PROJECT_ID=
# Firebase のウェブアプリの公開の設定。プロジェクト ID と両方そろうと、画面にログインのボタンを出す
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
# Firestore のデータベースの ID（省略時は (default)）
FIRESTORE_DATABASE_ID=
# 手元のエミュレーターにつなぐとき（例：127.0.0.1:8085 と 127.0.0.1:9099）
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
