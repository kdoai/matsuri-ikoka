# 接客サーバー（apps/server）の設定。
# このファイルを .env にコピーして値を入れる。.env は Git の対象外。
# ここには変数名と説明だけを書き、値は書かない。

# サーバーのポート（省略時は 8787）
PORT=

# 接客エージェントの動かし方：mock（記録したサンプルの相談を再生する。キー不要）/ live（Claude Agent SDK）
MATSURI_AGENT_MODE=

# live で使う Claude の API キー。Claude Code にログイン済みの環境では空のままでよい
ANTHROPIC_API_KEY=

# live で使うモデル名（コンシェルジュと、裏で調べるスタッフ）
MODEL_CONCIERGE=
MODEL_STAFF=

# 祭りのデータを読む場所（省略時は data/festivals。空なら、本番でなければ架空の祭りの data/samples/festivals）
MATSURI_FESTIVALS_DIR=

# 公開している URL の合言葉（画面からはヘッダー x-access-passcode で送る）。空なら確かめない
ACCESS_PASSCODE=

# 1日の相談の回数の上限。空か 0 なら上限なし
DAILY_CHAT_LIMIT=

# mock の再生の速さの倍率（1 で記録どおり、5 で5倍速、0 で待たない）
MATSURI_REPLAY_SPEED=

# live の1回の発言の費用の上限（米ドル、Agent SDK の推定で判定）。空なら上限なし
AGENT_MAX_BUDGET_USD=

# 同じオリジンから配る画面のビルドの場所（本番の既定は apps/web/dist。開発では Vite が配るので空でよい）
MATSURI_WEB_DIST=
