# 接客サーバー（apps/server）の設定。
# このファイルを .env にコピーして値を入れる。.env は Git の対象外。
# ここには変数名と説明だけを書き、値は書かない。

# サーバーのポート（省略時は 8787）
PORT=

# 接客エージェントの動かし方：mock（記録したサンプルの相談を再生する。キー不要）/ live（Claude Agent SDK）
MATSURI_AGENT_MODE=

# live で使う Claude の API キー。Claude Code にログイン済みの環境では空のままでよい
ANTHROPIC_API_KEY=

# live で使うモデル名（コンシェルジュと、裏で調べるスタッフ）
MODEL_CONCIERGE=
MODEL_STAFF=
